generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  GUEST
  USER
  WAITER
  ADMIN
}

enum OrderType {
  DINE_IN
  DELIVERY
  TAKEAWAY
}

enum OrderStatus {
  CREATED
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum TableStatus {
  FREE
  RESERVED
  OCCUPIED
  CLEANING
}

enum DishCategory {
  hot_drinks
  cold_drinks
  breakfast
  sandwiches
  main
  salads
  desserts
  signature
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  CARD
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  password       String
  role           Role           @default(USER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orders         Order[]
  reservations   Reservation[]
  refreshTokens  RefreshToken[]
  assignedTables Table[]        @relation("TableWaiter")

  @@map("users")
}

// Stored hashed refresh tokens — enables per-device invalidation
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Restaurant {
  id           String        @id @default(uuid())
  name         String
  address      String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tables       Table[]
  reservations Reservation[]

  @@map("restaurants")
}

// ---------------------------------------------------------------------------
// BUSINESS LOGIC RESPONSIBILITIES (enforced in service layer, NOT schema):
//
// 1. Table availability is derived dynamically from the Reservation table by
//    querying overlapping time ranges. TableStatus is a denormalized display
//    field only — it must NEVER be treated as the source of truth for booking
//    eligibility. ReservationsService.findAvailable() performs the canonical check.
//
// 2. Reservation conflict detection MUST be performed at the service level
//    before any reservation is created:
//      WHERE tableId = :id
//        AND startTime < :endTime
//        AND endTime   > :startTime
//    The @@index below supports this query; the guard lives in the service.
//
// 3. Order–table consistency rules:
//      DINE_IN  → tableId MUST be provided (validated in OrdersService.create)
//      DELIVERY → tableId MUST be null    (validated in OrdersService.create)
//      TAKEAWAY → tableId MUST be null    (validated in OrdersService.create)
// ---------------------------------------------------------------------------

model Table {
  id           String        @id @default(uuid())
  restaurantId String
  number       Int           @default(0)
  capacity     Int
  x            Float
  y            Float
  // Denormalized display hint — availability is derived from Reservation records.
  // Updated reactively after reservation create/cancel by ReservationsService.
  status             TableStatus   @default(FREE)
  cleaningStartedAt  DateTime?
  statusExpiresAt    DateTime?
  assignedWaiterId   String?
  createdAt          DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  restaurant       Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignedWaiter   User?         @relation("TableWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  reservations     Reservation[]
  orders           Order[]

  @@index([restaurantId])
  @@index([assignedWaiterId])
  @@map("tables")
}

model Dish {
  id          String       @id @default(uuid())
  name        String       @unique
  nameEn      String?
  price       Decimal      @db.Decimal(10, 2)
  category    DishCategory
  image       String?
  isAvailable Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderItems  OrderItem[]

  @@index([category])
  @@map("dishes")
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  type        OrderType
  status      OrderStatus @default(CREATED)
  scheduledAt     DateTime?
  // Nullable at schema level; DINE_IN requires non-null, enforced in OrdersService.
  tableId         String?
  // Nullable at schema level; DELIVERY requires non-null, enforced in OrdersService.
  deliveryAddress String?
  // Optional link to the reservation this order fulfils (DINE_IN only).
  reservationId   String?
  paymentMethod   PaymentMethod?
  totalAmount     Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  table       Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  items       OrderItem[]

  // Preorder scheduler: poll CONFIRMED orders where scheduledAt is within 15 min
  @@index([status, scheduledAt])
  @@index([userId])
  @@index([tableId])
  @@index([reservationId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  dishId    String
  quantity  Int
  // Price snapshot at order time — decoupled from future Dish.price changes
  unitPrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model Reservation {
  id             String            @id @default(uuid())
  userId         String
  tableId        String
  restaurantId   String
  numberOfGuests Int
  status         ReservationStatus @default(PENDING)
  startTime      DateTime
  endTime        DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  table          Table             @relation(fields: [tableId], references: [id], onDelete: Restrict)
  restaurant     Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  orders         Order[]

  // Conflict detection: WHERE tableId = ? AND startTime < endTime AND endTime > startTime
  @@index([tableId, startTime, endTime])
  // User reservation list with status filter
  @@index([userId, status])
  // Restaurant dashboard with date filter
  @@index([restaurantId, startTime])
  // Bulk status operations (cron, admin)
  @@index([status])
  @@map("reservations")
}
