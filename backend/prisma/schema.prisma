generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  USER
  WAITER
  ADMIN
}

enum OrderType {
  DINE_IN
  DELIVERY
  TAKEAWAY
}

enum OrderStatus {
  CREATED
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum TableStatus {
  FREE
  RESERVED
  OCCUPIED
  CLEANING
}

enum DishCategory {
  hot_drinks
  cold_drinks
  breakfast
  sandwiches
  main
  salads
  desserts
  signature
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  CARD
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  password       String
  role           Role           @default(USER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orders         Order[]
  reservations   Reservation[]
  refreshTokens  RefreshToken[]
  assignedTables Table[]        @relation("TableWaiter")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Restaurant {
  id           String        @id @default(uuid())
  name         String
  address      String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tables       Table[]
  reservations Reservation[]

  @@map("restaurants")
}

model Table {
  id           String        @id @default(uuid())
  restaurantId String
  number       Int           @default(0)
  capacity     Int
  x            Float
  y            Float
  status             TableStatus   @default(FREE)
  cleaningStartedAt  DateTime?
  statusExpiresAt    DateTime?
  assignedWaiterId   String?
  createdAt          DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  restaurant       Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignedWaiter   User?         @relation("TableWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  reservations     Reservation[]
  orders           Order[]

  @@index([restaurantId])
  @@index([assignedWaiterId])
  @@map("tables")
}

model Dish {
  id          String       @id @default(uuid())
  name        String       @unique
  nameEn      String?
  price       Decimal      @db.Decimal(10, 2)
  category    DishCategory
  image       String?
  isAvailable Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderItems  OrderItem[]

  @@index([category])
  @@map("dishes")
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  type        OrderType
  status      OrderStatus @default(CREATED)
  scheduledAt     DateTime?
  tableId         String?
  deliveryAddress String?
  reservationId   String?
  paymentMethod   PaymentMethod?
  totalAmount     Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  table       Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  items       OrderItem[]

  @@index([status, scheduledAt])
  @@index([userId])
  @@index([tableId])
  @@index([reservationId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  dishId    String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model Reservation {
  id             String            @id @default(uuid())
  userId         String
  tableId        String
  restaurantId   String
  numberOfGuests Int
  status         ReservationStatus @default(PENDING)
  startTime      DateTime
  endTime        DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  table          Table             @relation(fields: [tableId], references: [id], onDelete: Restrict)
  restaurant     Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  orders         Order[]

  @@index([tableId, startTime, endTime])
  @@index([userId, status])
  @@index([restaurantId, startTime])
  @@index([status])
  @@map("reservations")
}
